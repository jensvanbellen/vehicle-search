# Copy to .env and adjust. .env is gitignored — never commit real values.

# --- Core ---
VF_DB_PATH=data/vehicles.db
VF_HOME_POSTCODE=2548 AE
VF_LOG_LEVEL=INFO
VF_LOG_JSON=false

# --- HTTP politeness (applies to all live fetches) ---
VF_HTTP_TIMEOUT=30
VF_HTTP_MAX_RETRIES=3
VF_REQUEST_DELAY_SECONDS=2.0
VF_USER_AGENT=vehicle-finder/0.1 (personal use; contact: you@example.com)

# --- bmw.de live transport (Playwright). Optional; only for live bmw.de fetches. ---
# Leave headless=false for a polite, visible browser. Do NOT set up proxies here.
VF_BMWDE_ENABLED=false
VF_PLAYWRIGHT_HEADLESS=false

# --- Notifications (no real sends unless explicitly enabled) ---
VF_NOTIFY_ENABLED=false
# VF_NTFY_TOPIC=
# VF_SMTP_HOST=
